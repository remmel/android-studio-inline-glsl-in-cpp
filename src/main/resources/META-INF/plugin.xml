<idea-plugin>
    <id>com.remmel.inlineglsl</id>
    <name>Inline GLSL</name>
    <vendor>Remmel</vendor>
    <description><![CDATA[Highlights GLSL inside C++ raw strings with the <code>glsl</code> delimiter,
        or a preceding <code>// language=glsl</code> comment. Requires GLSL Support by Jan Polák.]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.cidr.lang</depends>
    <depends>GLSL</depends>
    <extensions defaultExtensionNs="com.intellij">
        <annotator language="ObjectiveC" implementationClass="com.remmel.inlineglsl.GlslRawStringAnnotator"/>
    </extensions>
</idea-plugin>
